{
  "name": "pozaf",
  "version": "1.0.0",
  "description": "Compartilhamento de tela p2p — app de desktop",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "start:vscode": "set ELECTRON_RUN_AS_NODE= && electron ."
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pozaf.app",
    "productName": "Pozaf",
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "desktop/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
